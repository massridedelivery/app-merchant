default_platform(:android)

platform :android do
  desc "Upload the App Bundle built by Flutter to Google Play"
  lane :deploy do
    track = ENV["SUPPLY_TRACK"] || "internal"

    upload_to_play_store(
      track: track,
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key: "play-service-account.json",
      release_status: track == "production" ? "completed" : "draft",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Promote the latest internal build to production"
  lane :promote do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      json_key: "play-service-account.json",
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
