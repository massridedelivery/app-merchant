# App Store Connect API credentials for `make deploy_dev`.
#
# Copy this file to `ios/.appstore_connect.env` (git-ignored) and fill in the
# values from App Store Connect → Users and Access → Integrations → Keys.
# The matching private key (.p8) must live at:
#   ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
#
APP_STORE_CONNECT_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_ISSUER_ID=00000000-0000-0000-0000-000000000000
