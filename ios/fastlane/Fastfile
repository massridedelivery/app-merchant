default_platform(:ios)

APP_IDENTIFIER = "com.mass.merchantApp".freeze

platform :ios do
  desc "Build a signed IPA and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: "./private_keys/AuthKey.p8",
      in_house: false,
    )

    # Fetch the App Store distribution certificate + provisioning profile from
    # the private match repo (read-only in CI).
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      readonly: true,
      api_key: api_key,
    )

    # Flutter produces the Xcode project/workspace; build the signed IPA.
    # Pass a unique build number so TestFlight accepts each upload.
    build_number = ENV["BUILD_NUMBER"]
    build_number_arg = build_number ? " --build-number=#{build_number}" : ""
    sh("cd .. && flutter build ipa --release#{build_number_arg} --export-options-plist=ios/ExportOptions.plist --dart-define-from-file=env/prod.json")

    # Flutter names the IPA after the app, which can differ from the pubspec
    # name (e.g. "Runner.ipa"). Glob for whatever it produced instead of
    # hard-coding a filename that a rename would silently break.
    # Relative to fastlane's working dir (ios/), same base as the build output.
    ipa_path = Dir.glob("../build/ios/ipa/*.ipa").first
    UI.user_error!("No .ipa found in build/ios/ipa/ — did `flutter build ipa` succeed?") unless ipa_path

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Sync signing certificates/profiles into the match repo (run locally, one-time)"
  lane :certificates do
    match(type: "appstore", app_identifier: APP_IDENTIFIER, readonly: false)
  end
end
