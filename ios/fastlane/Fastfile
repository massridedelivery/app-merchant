require "shellwords" # String#shellescape for the build paths below
require "fileutils"

default_platform(:ios)

APP_IDENTIFIER = "com.mass.merchantApp".freeze
TEAM_ID = "Q7742Z74Q3".freeze
PROFILE_NAME = "match AppStore #{APP_IDENTIFIER}".freeze

platform :ios do
  desc "Build a signed IPA and upload it to TestFlight"
  lane :beta do
    # CI: create a temporary keychain and import the match cert into it, so code
    # signing has a keychain to read the distribution identity from. No-op on a
    # normal developer machine (setup_ci only acts when CI is set).
    setup_ci

    # Pull the distribution cert + App Store profile from the match repo.
    # Read-only, and WITHOUT an api_key on purpose: an api_key makes match
    # invoke spaceship, which crashes signing the App Store Connect JWT on the
    # runner's OpenSSL 3 ("invalid curve name"). Read-only match only reads the
    # git repo (auth via MATCH_GIT_BASIC_AUTHORIZATION).
    match(
      type: "appstore",
      app_identifier: [APP_IDENTIFIER],
      readonly: true,
    )

    # The project ships with automatic signing; force manual signing against the
    # match-managed profile so the archive is reproducible on CI (no Apple
    # account / development profile needed). Absolute path so it resolves no
    # matter the action's working directory (__dir__ == ios/fastlane).
    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.expand_path("../Runner.xcodeproj", __dir__),
      team_id: TEAM_ID,
      targets: ["Runner"],
      build_configurations: ["Release"],
      profile_name: PROFILE_NAME,
      code_sign_identity: "Apple Distribution",
    )

    # Pass a unique build number so TestFlight accepts each upload.
    build_number = ENV["BUILD_NUMBER"]
    build_number_arg = build_number ? " --build-number=#{build_number}" : ""

    # The app ships under the production identity (com.mass.merchantApp) but for
    # now points at the DEV backend — set ENV_FILE=env/prod.json to cut over to
    # the production endpoint when it's ready.
    env_file = ENV["ENV_FILE"] || "env/dev.json"

    # fastlane runs `sh` from ios/fastlane, so a CWD-relative `cd ..` lands in
    # ios/, not the Flutter project root — leaving `flutter build ipa` unable to
    # find ios/ExportOptions.plist. Resolve everything from the Fastfile's own
    # location (__dir__ == ios/fastlane) so the paths hold no matter the CWD.
    repo_root = File.expand_path("../..", __dir__)
    export_plist = File.expand_path("../ExportOptions.plist", __dir__)
    sh("cd #{repo_root.shellescape} && flutter build ipa --release#{build_number_arg} --export-options-plist=#{export_plist.shellescape} --dart-define-from-file=#{env_file}")

    # Flutter names the IPA after the app, which can differ from the pubspec
    # name (e.g. "Runner.ipa"). Glob for whatever it produced instead of
    # hard-coding a filename that a rename would silently break.
    ipa_path = Dir.glob(File.join(repo_root, "build/ios/ipa/*.ipa")).first
    UI.user_error!("No .ipa found in build/ios/ipa/ — did `flutter build ipa` succeed?") unless ipa_path

    # Upload with altool, not upload_to_testflight/pilot: altool signs the App
    # Store Connect API JWT natively, dodging the same spaceship OpenSSL 3 curve
    # crash. altool reads the key from ~/.appstoreconnect/private_keys, so copy
    # the .p8 (written to ios/private_keys/AuthKey.p8 by CI) into place under the
    # key-id-derived name altool expects.
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_dir = File.expand_path("~/.appstoreconnect/private_keys")
    FileUtils.mkdir_p(key_dir)
    FileUtils.cp(
      File.expand_path("../private_keys/AuthKey.p8", __dir__),
      File.join(key_dir, "AuthKey_#{key_id}.p8"),
    )
    sh("xcrun altool --upload-app --type ios -f #{ipa_path.shellescape} " \
       "--apiKey #{key_id} --apiIssuer #{issuer_id}")
  end

  desc "Sync signing certificates/profiles into the match repo (run locally, one-time)"
  lane :certificates do
    # Run on a developer machine, where an api_key is fine (no OpenSSL 3 crash),
    # to create/update the distribution cert + App Store profile in the match repo.
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: "./private_keys/AuthKey.p8",
      in_house: false,
    )
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      readonly: false,
      api_key: api_key,
    )
  end
end
