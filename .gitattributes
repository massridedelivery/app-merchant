# Line endings are LF in the repository and LF in the working tree on every
# platform, so generated files (Flutter plugin registrants, Xcode and Gradle
# config) stay byte-identical no matter what each contributor's core.autocrlf
# is set to.
* text=auto eol=lf

# Windows toolchain files that genuinely need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never convert, never diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.jar  binary
*.zip  binary
*.keystore binary
*.jks  binary
